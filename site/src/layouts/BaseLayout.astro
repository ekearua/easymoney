---
import { SITE } from '../config';
import LandingLayout from './LandingLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/legal.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} · ${SITE.brand} by Xego`;

const navLinks = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#business', label: 'For business' },
  { href: '/#why-faya', label: 'Why FAYA' },
  { href: '/#faqs', label: 'FAQs' },
];
---

<LandingLayout title={pageTitle} description={description}>
  <SiteHeader links={navLinks} help="link" />
  <main>
    <slot />
  </main>
  <SiteFooter help="link" />
</LandingLayout>
