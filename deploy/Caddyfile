{$PUBLIC_HOST} {
	encode zstd gzip

	reverse_proxy app:8080 {
		health_uri /health/ready
		health_interval 10s
		health_timeout 3s
		health_status 200
		fail_duration 30s
		max_fails 2
		transport http {
			dial_timeout 3s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
