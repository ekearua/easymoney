APP_ENV=production
APP_NAME=Xego
PUBLIC_HOST=203-0-113-10.sslip.io
BASE_URL=https://203-0-113-10.sslip.io
LOG_LEVEL=info
# Structured log output: json (default, for log shippers) or text (dev console).
LOG_FORMAT=json

# PostgreSQL is private to Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with: go run ./cmd/demo hash-password
# This account bootstraps the admin console (role: admin). Additional
# operators are managed in /admin/admins with admin/compliance/support/readonly roles.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2a$10$replace_with_a_real_bcrypt_hash'

# Merchant-registration email confirmation. Standard user onboarding stores an
# email for checkout/receipts but does not require OTP.
EMAIL_CONFIRMATION_ENABLED=true
EMAIL_DEMO_CODE_IN_CHAT=false
EMAIL_VERIFICATION_TTL=10m
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@example.com

# Two-factor authentication (TOTP) for admin and merchant sign-in. On by
# default in production, where TOTP_ENCRYPTION_KEY is required.
# Generate a 32-byte key with: go run ./cmd/demo random-totp-key
TOTP_ENABLED=true
TOTP_ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes

# Encryption at rest (chat payloads + session CSRF tokens). Required in
# production. Generate a 32-byte key with: go run ./cmd/demo random-data-key
DATA_ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes

# Paystack TEST secret key only. The service rejects non-test verifications.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Meta WhatsApp Cloud API.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
# Business phone number in E.164 digits (no "+"), e.g. 2348012345678.
# Used to build wa.me pay links on the public invoice page.
WHATSAPP_PHONE_NUMBER=
# Set this to the currently supported version shown by Meta when configuring the app.
WHATSAPP_GRAPH_VERSION=vXX.X
WHATSAPP_STATUS_TEMPLATE=payment_status_update
WHATSAPP_TEMPLATE_LOCALE=en

# Telegram Bot API. Enable only after creating a bot and setting the webhook.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-telegram-webhook-secret
TELEGRAM_API_BASE=https://api.telegram.org

# SMS request-code webhook. Enable after configuring an inbound SMS provider.
SMS_ENABLED=false
SMS_PROVIDER=webhook
SMS_WEBHOOK_SECRET=replace-with-random-sms-webhook-secret
SMS_SENDER_ID=Xego
SMS_API_BASE=
SMS_API_KEY=

# Mobile data fulfilment. Use "simulated" locally or "vtpass" for VTPass sandbox.
DATA_PROVIDER=simulated
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_WEBHOOK_SECRET=
VTPASS_TIMEOUT=45s

# NIN/BVN identity verification (KYC Level 3). Use "simulated" locally; a live
# vendor (Smile ID / Youverify / Dojah / Prembly) plugs in behind the same port.
IDENTITY_PROVIDER=simulated

# Sanctions/PEP name screening. Simulated provider matches hard-coded demo names;
# a live OFAC/vendor list plugs in behind the same port.
SCREENING_PROVIDER=simulated
# How often customer profiles are automatically re-screened (rescreen worker).
KYC_RESCREEN_PERIOD=2160h

# Transaction monitoring (C14): suspicious-activity rules run every 15 minutes
# and feed alerts, review cases, and the ML/FT risk score.
MONITOR_VELOCITY_WINDOW=24h
MONITOR_VELOCITY_LIMIT=10
MONITOR_STRUCTURING_WINDOW=24h
MONITOR_STRUCTURING_COUNT=3
MONITOR_STRUCTURING_FLOOR_KOBO=4000000
MONITOR_STRUCTURING_CEIL_KOBO=10000000
MONITOR_ROUND_AMOUNT_STEP_KOBO=1000000
MONITOR_ROUND_AMOUNT_MIN_KOBO=1000000
# Comma-separated merchant categories treated as high-risk counterparties.
MONITOR_HIGH_RISK_CATEGORIES=Gambling,Forex,Crypto

PAYMENT_MIN_KOBO=10000
PAYMENT_MAX_KOBO=10000000
# How old a record must be before the retention purge (retain worker / daily
# ticker) archives it to the append-only ledger and deletes it. Legal holds
# freeze subjects regardless of this period.
RETENTION_PERIOD=2160h
CONVERSATION_TTL=30m
RECEIPT_TTL=2160h

# Distributed rate limiting. Empty REDIS_URL falls back to per-process
# in-memory counting (single replica only). Limits are per client IP per minute.
REDIS_URL=
RATE_LIMIT_WEBHOOKS_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_SCAN_PER_MINUTE=30

# Phase 3 event backbone. "memory" (default) is the Kafka-compatible in-memory
# bus; "kafka" uses segmentio/kafka-go and requires KAFKA_BROKERS. Events are
# written to business_event_outbox inside the producing transaction and drained
# by the publisher; notifications and compliance monitoring are event consumers.
EVENT_BUS=memory
EVENT_BUS_PARTITIONS=4
KAFKA_BROKERS=
KAFKA_GROUP_ID=xego

# Comma-separated list of phone numbers that can receive demo invoices.
INVOICE_ACCEPTED_NUMBERS=+2347061975340,+2348033072780

# PostgreSQL backups / WAL archiving / PITR (C23). PostgreSQL writes WAL
# segments into the local archive dir via deploy/pg-archive-wal.sh, and
# deploy/backup.sh takes a pg_basebackup full backup and ships base + WAL to
# an S3-compatible bucket (OCI Object Storage / AWS S3 / MinIO) with rclone.
# Configure the rclone remote once with: rclone --config <file> config
# BACKUP_BUCKET is required; the rest have defaults.
BACKUP_BUCKET=replace-with-bucket-name
BACKUP_PREFIX=whatsapp-payment
BACKUP_RETENTION_DAYS=30
BACKUP_RPO=1h
# Target recovery time objective for restore drills (measured, not enforced).
BACKUP_RTO=15m
# Local WAL archive directory shared by the archive_command and the scheduler.
# Docker Compose mounts this as the xego_backup named volume.
BACKUP_DIR=/var/lib/xego-backup
RCLONE_REMOTE=xegobackup
# Path to the rclone config file. Compose mounts it into the backup service.
# RCLONE_CONFIG=./deploy/rclone.conf
