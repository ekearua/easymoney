# Xego environment template. Copy to .env and fill in the placeholders. It is
# configured for a local/demo deployment: APP_ENV=development, Interswitch
# sandbox credentials and TEST checkout. Production (APP_ENV=production)
# additionally enforces a public HTTPS BASE_URL, LIVE checkout mode, live
# credentials on every money/identity rail, the encryption/TOTP keys and the
# real channel secrets — see GO_LIVE_RUNBOOK.md. There is no simulated
# switch on a money or identity rail: every such provider value below names a
# real integration, and an unknown value is rejected at configuration load. The
# advisory KYB review checks (CAC/FIRS/location) are the sole exception: they
# default to a simulated local disposition so the review step works before the
# live vendors are contracted.
APP_ENV=development
APP_NAME=Xego
PUBLIC_HOST=xego-test.kortiniafrica.com
BASE_URL=https://xego-test.kortiniafrica.com
LOG_LEVEL=info
# Structured log output: json (default, for log shippers) or text (dev console).
LOG_FORMAT=json

# PostgreSQL is private to Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with: go run ./cmd/demo hash-password
# This account bootstraps the admin console (role: admin). Additional
# operators are managed in /admin/admins with admin/compliance/support/readonly roles.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2a$10$replace_with_a_real_bcrypt_hash'

# Merchant-registration email confirmation. Standard user onboarding stores an
# email for checkout/receipts but does not require OTP.
EMAIL_CONFIRMATION_ENABLED=true
EMAIL_DEMO_CODE_IN_CHAT=false
EMAIL_VERIFICATION_TTL=10m
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@example.com

# Second-factor enforcement for admin and merchant sign-in (TOTP, emailed
# codes, or passkeys; per-subject enrollment lives at /admin/security and
# /merchant/security). On by default in production, where TOTP_ENCRYPTION_KEY
# is required.
# Generate a 32-byte key with: go run ./cmd/demo random-totp-key and keep it
# in the vault. Required before boot when TOTP_ENABLED=true (production
# enforces both the flag and a valid 64-hex key).
TOTP_ENABLED=true
TOTP_ENCRYPTION_KEY=

# Encryption at rest (chat payloads + session CSRF tokens). Required in
# production (non-empty 64-hex). Generate a 32-byte key with:
# go run ./cmd/demo random-data-key
DATA_ENCRYPTION_KEY=

# Interswitch Web Checkout is the sole card gateway. Use TEST credentials.
# The service rejects non-test verifications. Set CHECKOUT_MODE to TEST or LIVE.
INTERSWITCH_CLIENT_ID=replace_me
INTERSWITCH_CLIENT_SECRET=replace_me
INTERSWITCH_MERCHANT_CODE=replace_me
INTERSWITCH_PAY_ITEM_ID=replace_me
INTERSWITCH_BASE_URL=https://sandbox.interswitchng.com
# Host that renders the hosted payment page (the checkout form posts here). The legacy
# sandbox host serves its page scripts empty to browsers, so leave blank for the
# documented per-mode default: TEST https://newwebpay-sandbox.interswitchng.com,
# LIVE https://newwebpay.interswitchng.com. The requery always uses BASE_URL above.
# INTERSWITCH_CHECKOUT_BASE_URL=
INTERSWITCH_CHECKOUT_MODE=TEST
# Optional. Full URL of the OAuth token endpoint. When blank, the code
# automatically redirects sandbox-side credential pairs to passport-sandbox
# (the sandbox API host cannot mint tokens). Set this explicitly when the
# transfer rail lives on the QA host, whose passport endpoint is NOT on
# qa.interswitchng.com — Interswitch documents the QA token endpoint as
# `qa.interswitchng.com/passport/oauth/token` but it currently returns 404;
# ask your Interswitch TAM for the exact QA passport host.
# INTERSWITCH_TOKEN_URL=
# Optional. Overrides the Hosted Fields SDK script URL loaded by the card page
# (default: https://hostedfields.interswitchng.com/sdk.js in both modes). Set
# this when Interswitch provides a working sandbox SDK origin so test cards can
# charge through the sandbox webpay gateway instead of the live one.
# INTERSWITCH_HOSTED_FIELDS_SDK_URL=
# Required in production. The webhook secret generated for you in the
# Quickteller Business dashboard (Developer Tools -> Webhooks). Distinct from
# INTERSWITCH_CLIENT_SECRET. Used to verify the X-Interswitch-Signature header.
INTERSWITCH_WEBHOOK_SECRET=replace_me
# Optional Terminal ID returned by the OAuth token response and sent as the
# TerminalId header on Quickteller v5 endpoints (fund transfers, VTU). Set it
# as a fallback when your OAuth response omits terminalId.
# INTERSWITCH_TERMINAL_ID=
# Funding account number to use as the source for NIP single transfers
# (merchant settlement payouts) and VTU purchases. Required when
# PAYOUT_PROVIDER=interswitch or DATA_PROVIDER=interswitch.
# INTERSWITCH_SOURCE_ACCOUNT=
# Quickteller Send Money v5 API host for payouts, name enquiry, and transaction
# query. Defaults to https://qa.interswitchng.com/quicktellerservice/api/v5 in
# TEST. Set it to your provisioned production quicktellerservice host in LIVE.
# INTERSWITCH_TRANSFER_BASE_URL=
# Transfer sender identity attached to each NIP payout. The technical rail does
# not require it, but Interswitch validates these when present.
# INTERSWITCH_SENDER_NAME=Xego
# INTERSWITCH_SENDER_PHONE=
# INTERSWITCH_SENDER_EMAIL=
# Initiating entity code on the v5 TransferFunds request. Default "PBL" per the
# published Interswitch samples; override only if Xego is provisioned with a
# different entity code.
# INTERSWITCH_INITIATING_ENTITY_CODE=PBL
# Card checkout render mode: hosted_fields (default, secure inline iframe) or
# legacy (Web Checkout redirect form; posts only on the customer's deliberate
# Continue-to-Interswitch tap).
INTERSWITCH_CHECKOUT_RENDER=hosted_fields
# Primary payment gateway. Gateway wiring always registers Interswitch (card
# checkout and bank-transfer DVA); production uses this value to require the
# Interswitch credentials above.
PAYMENT_PROVIDER=interswitch

# Bank-transfer collection rail. "interswitch" (dynamic virtual accounts on
# the virtual-accounts API) is the only accepted value and the default.
BANK_TRANSFER_MODE=interswitch
# Settlement payout rail: Interswitch NIP single transfer. In production this
# also requires INTERSWITCH_TRANSFER_BASE_URL and INTERSWITCH_SOURCE_ACCOUNT.
PAYOUT_PROVIDER=interswitch
# Refund rail: Interswitch refund API.
REFUND_PROVIDER=interswitch

# Rails are validated at configuration load: every provider value names a real
# integration, simulated values no longer exist, and unknown values are
# rejected in every environment (there is no override). Production additionally
# requires INTERSWITCH_CHECKOUT_MODE=LIVE and a public HTTPS BASE_URL.

# Xego platform fee configuration (kobo). Applied as a split on merchant
# collection payments. Fee = min(pct * amount + fixed, cap).
XEGO_FEE_CARD_BPS=200
XEGO_FEE_CARD_FIXED_KOBO=10000
XEGO_FEE_CARD_CAP_KOBO=350000
XEGO_FEE_DVA_BPS=150
XEGO_FEE_DVA_FIXED_KOBO=0
XEGO_FEE_DVA_CAP_KOBO=150000
XEGO_FEE_TRANSFER_BPS=180
XEGO_FEE_TRANSFER_FIXED_KOBO=0
XEGO_FEE_TRANSFER_CAP_KOBO=250000
XEGO_FEE_NIP_PAYOUT_FLAT_KOBO=10000

# Merchant settlement (payout rail). Fee = bps of the settled amount; a payout
# must sit inside [min, max] and respect the per-day cap and count.
SETTLEMENT_FEE_BPS=250
PAYOUT_MIN_KOBO=10000
PAYOUT_MAX_KOBO=1000000
PAYOUT_DAILY_CAP_KOBO=5000000
PAYOUT_DAILY_COUNT_LIMIT=10

# Meta WhatsApp Cloud API.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
# Business phone number in E.164 digits (no "+"), e.g. 2348012345678.
# Used to build wa.me pay links on the public invoice page.
WHATSAPP_PHONE_NUMBER=
# Set this to the currently supported version shown by Meta when configuring
# the app; the loader rejects anything that is not v<major>.<minor>.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_STATUS_TEMPLATE=payment_status_update
WHATSAPP_TEMPLATE_LOCALE=en

# Telegram Bot API. Enable only after creating a bot and setting the webhook.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-telegram-webhook-secret
TELEGRAM_API_BASE=https://api.telegram.org

# Instagram Messaging (Meta Graph API). Requires a professional Instagram
# account linked to a Facebook Page and an app with instagram_manage_messages.
# The webhook URL is https://<host>/webhooks/instagram with the verify token
# below; signature validation uses INSTAGRAM_APP_SECRET (X-Hub-Signature-256).
INSTAGRAM_ENABLED=false
INSTAGRAM_APP_SECRET=replace-with-meta-app-secret
INSTAGRAM_ACCESS_TOKEN=replace-with-instagram-access-token
INSTAGRAM_IG_ID=replace-with-instagram-business-account-id
INSTAGRAM_VERIFY_TOKEN=replace-with-a-random-webhook-token
# Optional Facebook Page id used as the message send object. When unset the
# adapter sends as INSTAGRAM_IG_ID.
# INSTAGRAM_PAGE_ID=
INSTAGRAM_GRAPH_VERSION=v23.0

# TikTok Business Messaging. Full-parity channel adapter: interactive
# primitives (buttons, lists, templates) degrade to numbered text menus and
# plain links because the platform has no interactive DM primitives. The
# webhook URL is https://<host>/webhooks/tiktok; signature validation uses
# TIKTOK_APP_SECRET (TikTok-Signature header).
TIKTOK_ENABLED=false
TIKTOK_APP_SECRET=replace-with-tiktok-app-secret
TIKTOK_ACCESS_TOKEN=replace-with-tiktok-access-token
TIKTOK_API_BASE=https://open.tiktokapis.com

# SMS request-code webhook. Enable after configuring an inbound SMS provider.
# SMS_PROVIDER=webhook keeps replies synchronous (returned directly to the
# inbound carrier). SMS_PROVIDER=http adds asynchronous outbound delivery:
# orders/receipts are sent to SMS_API_BASE (Termii, Africa's Talking, Twilio,
# SMS360, ...) and the gateway reports delivery status to POST
# /webhooks/sms/status using the same SMS_WEBHOOK_SECRET header.
# The outbound gateway is expected to accept this JSON contract:
# {"to": "...", "message": "...", "sender_id": "...", "reference": "..."}
# and return a message identifier in message_id, messageId, msg_id, id, or
# reference. It is then sent as both "Authorization: Bearer <key>" and
# "X-API-Key: <key>".
SMS_ENABLED=false
SMS_PROVIDER=webhook
SMS_WEBHOOK_SECRET=replace-with-random-sms-webhook-secret
SMS_SENDER_ID=Xego
SMS_API_BASE=
SMS_API_KEY=

# Mobile data fulfilment. "vtpass" (default; sandbox or live keys) or
# "interswitch" for the Quickteller VTU rail (requires INTERSWITCH_SOURCE_ACCOUNT).
DATA_PROVIDER=vtpass
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_WEBHOOK_SECRET=
VTPASS_TIMEOUT=45s

# NIN/BVN identity verification (CBN Tier 2). "ninbvnportal" (the default and
# the only supported value) calls the live ninbvnportal.com.ng lookup API.
# NINBVNPORTAL_API_KEY is required: the app refuses to start without an
# identity vendor key. Other vendors plug in behind the same port.
IDENTITY_PROVIDER=ninbvnportal
NINBVNPORTAL_API_KEY=
NINBVNPORTAL_BASE_URL=https://ninbvnportal.com/api
NINBVNPORTAL_TIMEOUT=30s

# Corporate-registry (CAC/RC), tax-ID (FIRS TIN) and operating-address checks
# used by the merchant KYB review step. These are advisory: the reviewer sees a
# proposed disposition (verified / mismatch / not_found) and confirms it by
# hand. "simulated" (the default) derives that disposition in-process with no
# external call; "http" calls the live adapter and requires the matching
# *_API_BASE. The *_API_KEY, when set, is sent as both Authorization: Bearer
# and X-API-Key.
CAC_PROVIDER=simulated
# CAC_PROVIDER=http -> POST {CAC_API_BASE}/corporate-verification
CAC_API_BASE=
CAC_API_KEY=
CAC_TIMEOUT=30s
FIRS_PROVIDER=simulated
# FIRS_PROVIDER=http -> POST {FIRS_API_BASE}/tin-verification
FIRS_API_BASE=
FIRS_API_KEY=
FIRS_TIMEOUT=30s
LOCATION_PROVIDER=simulated
# LOCATION_PROVIDER=http -> POST {LOCATION_API_BASE}/location-verification
LOCATION_API_BASE=
LOCATION_API_KEY=
LOCATION_TIMEOUT=30s
# Maximum acceptable distance (metres) between the declared operating address
# and the device location the merchant shares with browser permission.
LOCATION_MAX_DISTANCE_M=5000

# Sanctions/PEP name screening through the generic HTTP adapter: POSTs to
# {SCREENING_API_BASE}/screen and maps a {decision|status, matched_names,
# reference} JSON response onto clear/possible/strong. SCREENING_API_BASE is
# required — the app refuses to start without it.
SCREENING_PROVIDER=http
# Generic HTTP screening adapter: POSTs to {SCREENING_API_BASE}/screen with the
# identity fields and maps a {decision|status, matched_names, reference} JSON
# response onto clear/possible/strong. Auth key is sent as both Authorization
# Bearer and X-API-Key when set.
SCREENING_API_BASE=
SCREENING_API_KEY=
SCREENING_TIMEOUT=30s
# How often customer profiles are automatically re-screened (rescreen worker).
KYC_RESCREEN_PERIOD=2160h

# Payment-time counterparty screening for money-out rails (spec G2): every
# merchant payout and wallet withdrawal is screened in the ReserveAllowance ->
# dispatch window. Confirmed hits interdict the movement; ambiguous hits hold
# it for review with the allowance reservation in place; a screener outage
# holds rather than clears. "simulated" is the deterministic vendor stand-in;
# the live adapter (G9 screening purchase) drops in behind the same port.
PAYMENT_SCREENING_PROVIDER=simulated
# How often the audit hash chain is re-verified by the scheduled sweep (G7).
# Each sweep records its result and a clean-to-broken transition raises one
# alert with a reviewer disposition on the audit page.
AUDIT_CHAIN_VERIFY_INTERVAL=1h

# Chat reminders for incomplete onboarding. The worker sweeps every INTERVAL;
# a user is eligible once first contact is older than START_AFTER (or their
# conversation session stalled longer than STALL_AFTER), gets at most MAX
# reminders per stage spaced at least GAP apart, and never during quiet hours
# (platform time). WhatsApp reminders outside the 24-hour service window need
# an approved utility template: leave TEMPLATE empty to record those attempts
# as pending_template (skipped, never a raw text) until Meta approves one.
ONBOARDING_REMINDER_INTERVAL=6h
ONBOARDING_REMINDER_START_AFTER=24h
ONBOARDING_REMINDER_STALL_AFTER=12h
ONBOARDING_REMINDER_GAP=48h
ONBOARDING_REMINDER_MAX=3
ONBOARDING_REMINDER_QUIET_START=20
ONBOARDING_REMINDER_QUIET_END=8
ONBOARDING_REMINDER_TEMPLATE=
ONBOARDING_REMINDER_TEMPLATE_LOCALE=en

# Database pool sizing (production requirements #1): connections opened per
# app replica (workbook env names, sheet "Concurrency & Pool Tuning" s6).
# Defaults 25/5; compose overrides to 30 to match the PgBouncer
# transaction pool between the app and PostgreSQL. Values are floored at 1,
# and DB_POOL_MIN never exceeds DB_POOL_MAX.
DB_POOL_MAX=25
DB_POOL_MIN=5

# Background worker pools (production requirements #3). Every tick handler
# runs on its own gate; these bound the goroutines per class (inbound and
# outbox bound the fan-out inside their batch handlers). Defaults follow the
# requirements workbook (10 inbound, 5 outbox, 3 reconcilers); values are
# floored at 1.
WORKER_INBOUND_CONCURRENCY=10
WORKER_OUTBOX_CONCURRENCY=5
WORKER_WEBHOOK_CONCURRENCY=4
WORKER_DATA_CONCURRENCY=4
WORKER_RECONCILE_CONCURRENCY=3
WORKER_MISC_CONCURRENCY=3

# AI conversations, image-to-text (OCR), and voice-to-text (STT) through a
# single OpenAI-compatible provider (chat, vision, Whisper). AI_ENABLED=false
# turns all three ports off and falls back to keyword/menu handling. When
# enabled, AI_API_KEY is required; "simulated" is no longer a valid provider
# and is rejected at configuration load.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30s
# Requests per minute per customer (intent classification, OCR/STT, assistant).
# Rate-limited calls degrade to keyword/menu handling instead of failing.
# Must be > 0 when AI_ENABLED=true in production.
AI_MAX_REQUESTS_PER_MINUTE=30
# Estimated token spend: tokens per ₦1 used by the admin AI cost views.
AI_TOKENS_PER_NGN=250

# Transaction monitoring (C14): suspicious-activity rules run every 15 minutes
# over every settled rail — card/transfer payments, wallet top-ups, standing
# (reusable) account bank credits, refunds, and merchant settlement payouts —
# and feed alerts, review cases, and the ML/FT risk score.
MONITOR_VELOCITY_WINDOW=24h
MONITOR_VELOCITY_LIMIT=10
MONITOR_STRUCTURING_WINDOW=24h
MONITOR_STRUCTURING_COUNT=3
MONITOR_STRUCTURING_FLOOR_KOBO=4000000
MONITOR_STRUCTURING_CEIL_KOBO=10000000
MONITOR_ROUND_AMOUNT_STEP_KOBO=1000000
MONITOR_ROUND_AMOUNT_MIN_KOBO=1000000
# Comma-separated merchant categories treated as high-risk counterparties.
MONITOR_HIGH_RISK_CATEGORIES=Gambling,Forex,Crypto
# Currency-transaction reporting threshold shown on /admin/reports (kobo).
REPORT_CTR_THRESHOLD_KOBO=1000000000
# M3 Trust Fabric step-up: a KYC profile in the high risk band has its
# single-transaction allowance capped at this ceiling (kobo) until review
# clears the band. 0 disables the cap.
RISK_HIGH_SINGLE_LIMIT_KOBO=50000
# How long one ML/FT risk observation's contribution to the customer's risk
# score takes to fall by half. Default 2160h (90 days), the same clock the
# rescreen worker runs on, so a suspicion fades unless it is renewed.
# 0 disables decay and keeps every observation at full weight forever — the
# behaviour that ratchets a customer who collects dismissed alerts.
# Resolving an alert as a false positive cancels its weight regardless.
RISK_DECAY_HALF_LIFE=2160h
# Compliance-queue tuning suggestions: a detection rule whose labelled
# false-positive share over the 7-day window reaches TUNING_FP_PERCENT
# with at least TUNING_MIN_LABELLED outcomes gets a suggestion surfaced.
TUNING_FP_PERCENT=60
TUNING_MIN_LABELLED=10

PAYMENT_MIN_KOBO=10000
# Absolute platform ceiling; per-tier CBN ceilings (internal/kyc) sit below this.
PAYMENT_MAX_KOBO=1000000000
# How old a record must be before the retention purge (retain worker / daily
# ticker) archives it to the append-only ledger and deletes it. Legal holds
# freeze subjects regardless of this period. The AML floor below clamps this
# for every AML-scope class regardless of how small this is set.
RETENTION_PERIOD=2160h
# G6 (MLPPA 2022 record-keeping floor): AML-scope records - payments,
# invoices, thrift, audit, merchant registrations, and account records of
# never-transacted users - are never hard-deleted younger than five years.
# Financial classes are also archived before any purge. Config rejects values
# under 5y (or RETENTION_PERIOD above it); 0 disables the floor, dev only.
AML_RECORD_RETENTION=43800h
CONVERSATION_TTL=30m
RECEIPT_TTL=2160h

# Distributed rate limiting. Empty REDIS_URL falls back to per-process
# in-memory counting (single replica only). Limits are per client IP per minute.
REDIS_URL=
RATE_LIMIT_WEBHOOKS_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_SCAN_PER_MINUTE=30
# Per Partner API key per minute (HMAC-signed requests).
RATE_LIMIT_API_KEYS_PER_MINUTE=300

# Phase 3 event backbone. "memory" (default) is the Kafka-compatible in-memory
# bus; "kafka" uses segmentio/kafka-go and requires KAFKA_BROKERS. Events are
# written to business_event_outbox inside the producing transaction and drained
# by the publisher; notifications and compliance monitoring are event consumers.
EVENT_BUS=memory
EVENT_BUS_PARTITIONS=4
KAFKA_BROKERS=
KAFKA_GROUP_ID=xego

# Link a second chat channel to one wallet (/link). LINK_DEMO_CODE_IN_CHAT
# returns the OTP in chat for local demos and is rejected when
# APP_ENV=production.
LINK_ACCOUNTS_ENABLED=false
LINK_CODE_TTL=10m
LINK_DEMO_CODE_IN_CHAT=false
# Outbound messaging meter: every outbound message is logged and priced with
# these naira estimates for the admin cost views.
MESSAGE_LOG_ENABLED=true
MESSAGE_COST_SERVICE_NGN=14
MESSAGE_COST_MARKETING_NGN=84
# Log raw webhook bodies at INFO for signature/debugging work. Off by default
# (bodies can carry PII).
WEBHOOK_BODY_LOG_ENABLED=false
# Browser web flows (/w/<token>). Disabling a flow type (comma-separated)
# keeps the chat FSM for it; Telegram and SMS always keep the chat FSM.
WEB_FLOWS_ENABLED=true
# WEB_FLOWS_DISABLED_FLOWS=
# How long a signed-in admin/merchant session stays valid.
AUTH_SESSION_TTL=12h

# Comma-separated list of phone numbers that can receive demo invoices.
INVOICE_ACCEPTED_NUMBERS=+2347061975340,+2348033072780

# PostgreSQL backups / WAL archiving / PITR (C23). PostgreSQL writes WAL
# segments into the local archive dir via deploy/pg-archive-wal.sh, and
# deploy/backup.sh takes a pg_basebackup full backup and ships base + WAL to
# an S3-compatible bucket (OCI Object Storage / AWS S3 / MinIO) with rclone.
# Configure the rclone remote once with: rclone --config <file> config
# BACKUP_BUCKET is required; the rest have defaults.
BACKUP_BUCKET=replace-with-bucket-name
BACKUP_PREFIX=whatsapp-payment
BACKUP_RETENTION_DAYS=30
BACKUP_RPO=1h
# Target recovery time objective for restore drills (measured, not enforced).
BACKUP_RTO=15m
# Local WAL archive directory shared by the archive_command and the scheduler.
# Docker Compose mounts this as the xego_backup named volume.
BACKUP_DIR=/var/lib/xego-backup
RCLONE_REMOTE=xegobackup
# Path to the rclone config file. Compose mounts it into the backup service.
# RCLONE_CONFIG=./deploy/rclone.conf

