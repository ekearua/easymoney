*.sh text eol=lf

# Long-lived design and compliance documents are checked in with LF line
# endings so the AML spec, the vendor decision record, the vendor evidence
# pack and the saved-card plan/decision pair stay diff-stable across platforms;
# a Windows checkout would otherwise rewrite whole files and bury real edits in
# whitespace noise.
CBN_AML_COMPLIANCE_SPEC.md text eol=lf
AML_VENDOR_DECISION_RECORD.md text eol=lf
AML_VENDOR_EVIDENCE_PACK.md text eol=lf
SAVED_CARD_METHODS_PLAN.md text eol=lf
CARD_ON_FILE_DECISION.md text eol=lf
